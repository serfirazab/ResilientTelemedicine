@page "/"
@using Appointment.Shared.DTOs
@using Appointment.Shared.Models
@inject IHttpClientFactory ClientFactory
@rendermode InteractiveServer

<PageTitle>Telemedicine Booking</PageTitle>

<div class="dashboard-wrapper">
    <div class="dashboard-container">
        
        <!-- Hero Header -->
        <div class="hero-header">
            <div>
                <h1 class="hero-title">Book a Specialist</h1>
                <p class="text-muted mb-0" style="font-size: 1.1rem;">Schedule your online consultation securely.</p>
            </div>
            
            <div class="mode-toggle">
                <button class="toggle-btn @(!isResilientMode ? "active-naive" : "")" @onclick="() => isResilientMode = false">
                    <i class="bi bi-shield-slash"></i> Naive API
                </button>
                <button class="toggle-btn @(isResilientMode ? "active-resilient" : "")" @onclick="() => isResilientMode = true">
                    <i class="bi bi-shield-check"></i> Resilient Polly
                </button>
            </div>
        </div>

        <div class="row g-5">
            <!-- Left Column: Booking Form -->
            <div class="col-lg-6">
                <div class="glass-card">
                    <div class="card-header-glass">
                        <h4 class="mb-0 fw-bold" style="color: #0f172a;">Appointment Details</h4>
                    </div>
                    <div class="card-body-glass">
                        
                        <div class="input-group-custom">
                            <label class="input-label">Select Specialist</label>
                            <div class="doctor-grid">
                                <div class="doctor-card @(bookingRequest.DoctorId == "DOC-101" ? "selected" : "")" @onclick="@(() => SelectDoctor("DOC-101"))">
                                    <img src="/images/doctors/doc101.png" class="doctor-avatar" alt="Dr. Sarah Jenkins" />
                                    <div class="doctor-info">
                                        <h5>Dr. Sarah Jenkins</h5>
                                        <p>Cardiology</p>
                                    </div>
                                </div>
                                <div class="doctor-card @(bookingRequest.DoctorId == "DOC-202" ? "selected" : "")" @onclick="@(() => SelectDoctor("DOC-202"))">
                                    <img src="/images/doctors/doc202.png" class="doctor-avatar" alt="Dr. Michael Chen" />
                                    <div class="doctor-info">
                                        <h5>Dr. Kenji Tanaka</h5>
                                        <p>Neurology</p>
                                    </div>
                                </div>
                                <div class="doctor-card @(bookingRequest.DoctorId == "DOC-303" ? "selected" : "")" @onclick="@(() => SelectDoctor("DOC-303"))">
                                    <img src="/images/doctors/doc303.png" class="doctor-avatar" alt="Dr. Emily Stone" />
                                    <div class="doctor-info">
                                        <h5>Dr. Emily Stone</h5>
                                        <p>Pediatrics</p>
                                    </div>
                                </div>
                                <div class="doctor-card @(bookingRequest.DoctorId == "DOC-404" ? "selected" : "")" @onclick="@(() => SelectDoctor("DOC-404"))">
                                    <img src="/images/doctors/doc404.png" class="doctor-avatar" alt="Dr. James Wilson" />
                                    <div class="doctor-info">
                                        <h5>Dr. A. Bennett</h5>
                                        <p>General Practice</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="input-group-custom">
                            <label class="input-label">Patient Full Name</label>
                            <input type="text" class="premium-input" placeholder="e.g. John Doe" @bind="bookingRequest.PatientId" />
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-group-custom">
                                    <label class="input-label">Insurance Policy No.</label>
                                    <input type="text" class="premium-input" placeholder="INS-..." @bind="bookingRequest.InsuranceNumber" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-group-custom">
                                    <label class="input-label">Estimated Cost ($)</label>
                                    <input type="number" class="premium-input" @bind="bookingRequest.EstimatedCost" />
                                </div>
                            </div>
                        </div>

                        <button class="btn-premium mt-3" @onclick="BookAppointment" disabled="@isBooking">
                            @if (isBooking)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Securing Appointment...</span>
                            }
                            else
                            {
                                <span>Confirm Booking</span>
                            }
                        </button>

                        @if (!string.IsNullOrEmpty(statusMessage))
                        {
                            <div class="custom-alert mt-4 @(isSuccess ? "alert-success-custom" : "alert-danger-custom")">
                                <i class="bi @(isSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
                                @statusMessage
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <!-- Right Column: Recent Appointments -->
            <div class="col-lg-6">
                <div class="glass-card">
                    <div class="card-header-glass d-flex justify-content-between align-items-center">
                        <h4 class="mb-0 fw-bold" style="color: #0f172a;">Upcoming Consultations</h4>
                        <button class="btn btn-sm btn-light rounded-pill px-3 shadow-sm" @onclick="LoadAppointments">
                            <i class="bi bi-arrow-clockwise"></i> Sync
                        </button>
                    </div>
                    <div class="card-body-glass">
                        @if (appointments == null)
                        {
                            <div class="text-center p-5 text-muted">
                                <div class="spinner-border text-primary mb-3" role="status"></div>
                                <p>Loading your schedule...</p>
                            </div>
                        }
                        else if (!appointments.Any())
                        {
                            <div class="text-center p-5 text-muted">
                                <i class="bi bi-calendar-x fs-1 mb-2 text-secondary"></i>
                                <p>No upcoming appointments found.</p>
                            </div>
                        }
                        else
                        {
                            <div class="appt-list">
                                @foreach (var appt in appointments.OrderByDescending(a => a.CreatedAt).Take(5))
                                {
                                    <div class="appt-card">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="/images/doctors/@GetDoctorImage(appt.DoctorId.ToString())" class="doctor-avatar" style="width:50px; height:50px;" alt="Doctor" />
                                            <div>
                                                <h6 class="mb-1 fw-bold" style="color: #0f172a;">@appt.PatientName</h6>
                                                <p class="mb-0 text-muted" style="font-size: 0.85rem;">
                                                    <i class="bi bi-calendar-event me-1"></i> @appt.SlotStart.ToLocalTime().ToString("MMM dd, yyyy - HH:mm")
                                                </p>
                                            </div>
                                        </div>
                                        <div>
                                            @{
                                                var isConfirmed = appt.Status == AppointmentStatus.Confirmed;
                                                var statusClass = isConfirmed ? "status-confirmed" : "status-pending";
                                            }
                                            <span class="status-badge @statusClass">
                                                @appt.Status
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private AppointmentBookingRequest bookingRequest = new AppointmentBookingRequest
    {
        PatientId = "Alice Freeman",
        DoctorId = "DOC-101",
        InsuranceNumber = "INS-8899",
        EstimatedCost = 150.0m,
        RequestedTime = DateTime.UtcNow.AddDays(1)
    };

    private bool isBooking = false;
    private bool isResilientMode = true; // Default to resilient
    private string statusMessage = "";
    private bool isSuccess = false;
    private List<global::Appointment.Shared.Models.Appointment>? appointments;

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointments();
    }

    private void SelectDoctor(string doctorId)
    {
        bookingRequest.DoctorId = doctorId;
    }

    private async Task LoadAppointments()
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiClient");
            appointments = await client.GetFromJsonAsync<List<global::Appointment.Shared.Models.Appointment>>("/api/appointments");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading appointments: {ex.Message}");
        }
    }

    private async Task BookAppointment()
    {
        isBooking = true;
        statusMessage = isResilientMode ? "Booking with Polly Resilience... (Expect success!)" : "Booking in Naive mode... (Expect failures!)";
        isSuccess = false;
        StateHasChanged();

        try
        {
            var endpoint = isResilientMode ? "/api/appointments/book-resilient" : "/api/appointments/book-naive";
            
            var client = ClientFactory.CreateClient("ApiClient");
            var response = await client.PostAsJsonAsync(endpoint, bookingRequest);
            
            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
                statusMessage = $"Appointment booked successfully! (Mode: {(isResilientMode ? "Resilient" : "Naive")})";
                await LoadAppointments();
                
                // Reset form slightly
                bookingRequest.PatientId = "P-" + Guid.NewGuid().ToString().Substring(0, 5);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                isSuccess = false;
                statusMessage = $"Failed: {response.StatusCode}. {error}";
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            statusMessage = $"System Error: {ex.Message} (Simulated Chaos)";
        }
        finally
        {
            isBooking = false;
            StateHasChanged();
        }
    }

    private string GetDoctorImage(string doctorId)
    {
        return doctorId switch
        {
            "DOC-101" => "doc101.png",
            "DOC-202" => "doc202.png",
            "DOC-303" => "doc303.png",
            "DOC-404" => "doc404.png",
            _ => "doc101.png"
        };
    }
}
