@page "/"
@using Appointment.Shared.DTOs
@using Appointment.Shared.Models
@inject IHttpClientFactory ClientFactory
@rendermode InteractiveServer

<PageTitle>Telemedicine Dashboard</PageTitle>

<h1>Telemedicine Dashboard (Naive Mode)</h1>

<div class="dashboard-container mt-3">
    <div class="row g-4">
        <div class="col-md-5">
            <div class="premium-card">
                <div class="card-header-custom">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-calendar-plus me-2"></i>Book New Appointment</h4>
                    <p class="text-muted small mb-0 mt-1">Select mode and observe the behavior!</p>
                </div>
                <div class="card-body-custom">
                    
                    <div class="d-flex justify-content-between align-items-center mb-4 p-3 rounded" style="background-color: #f8f9fa; border: 1px solid #dee2e6;">
                        <span class="fw-bold @(!isResilientMode ? "text-danger" : "text-muted")">
                            <i class="bi bi-shield-slash"></i> Naive (Phase 3)
                        </span>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="modeSwitch" style="width: 3rem; height: 1.5rem; cursor: pointer;" @bind="isResilientMode">
                        </div>
                        <span class="fw-bold @(isResilientMode ? "text-success" : "text-muted")">
                            <i class="bi bi-shield-check"></i> Resilient (Phase 4)
                        </span>
                    </div>

                    <div class="form-floating mb-3">
                        <input class="form-control custom-input" id="patientName" placeholder="John Doe" @bind="bookingRequest.PatientId" />
                        <label for="patientName">Patient Full Name</label>
                    </div>
                    <div class="form-floating mb-3">
                        <select class="form-select custom-input" id="doctorSelect" @bind="bookingRequest.DoctorId">
                            <option value="DOC-101">Dr. Sarah Jenkins (Cardiology)</option>
                            <option value="DOC-202">Dr. Michael Chen (Neurology)</option>
                            <option value="DOC-303">Dr. Emily Stone (Pediatrics)</option>
                            <option value="DOC-404">Dr. James Wilson (General Practice)</option>
                        </select>
                        <label for="doctorSelect">Select Specialist</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input class="form-control custom-input" id="insurance" placeholder="INS-..." @bind="bookingRequest.InsuranceNumber" />
                        <label for="insurance">Insurance Policy Number</label>
                    </div>
                    <div class="form-floating mb-4">
                        <input type="number" class="form-control custom-input" id="cost" @bind="bookingRequest.EstimatedCost" />
                        <label for="cost">Estimated Cost ($)</label>
                    </div>
                    <button class="btn btn-primary-custom w-100 py-3 fw-bold" @onclick="BookAppointment" disabled="@isBooking">
                        @if (isBooking)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Processing with External Services...</span>
                        }
                        else
                        {
                            <span>Confirm Booking</span>
                        }
                    </button>

                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="alert mt-4 custom-alert @(isSuccess ? "alert-success-custom" : "alert-danger-custom")">
                            <i class="bi @(isSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
                            @statusMessage
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-md-7">
            <div class="premium-card h-100">
                <div class="card-header-custom d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2"></i>Recent Appointments</h4>
                        <p class="text-muted small mb-0 mt-1">Live from Appointment Database</p>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="LoadAppointments">
                        <i class="bi bi-arrow-clockwise"></i> Refresh
                    </button>
                </div>
                <div class="card-body-custom p-0">
                    @if (appointments == null)
                    {
                        <div class="text-center p-5 text-muted">
                            <div class="spinner-border text-primary mb-3" role="status"></div>
                            <p>Loading records...</p>
                        </div>
                    }
                    else if (!appointments.Any())
                    {
                        <div class="text-center p-5 text-muted">
                            <i class="bi bi-inbox fs-1"></i>
                            <p class="mt-2">No appointments scheduled yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush custom-list">
                            @foreach (var appt in appointments.OrderByDescending(a => a.CreatedAt).Take(8))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center p-4">
                                    <div>
                                        <h6 class="mb-1 fw-bold">@appt.PatientName</h6>
                                        <p class="mb-0 text-muted small">
                                            <i class="bi bi-person-badge me-1"></i> Doctor: @(GetDoctorName(appt.DoctorId.ToString()))
                                        </p>
                                        <p class="mb-0 text-muted small">
                                            <i class="bi bi-calendar-event me-1"></i> @appt.SlotStart.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                        </p>
                                    </div>
                                    <span class="badge rounded-pill bg-success-custom px-3 py-2">
                                        @appt.Status
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private AppointmentBookingRequest bookingRequest = new AppointmentBookingRequest
    {
        PatientId = "Alice Freeman",
        DoctorId = "DOC-101",
        InsuranceNumber = "INS-8899",
        EstimatedCost = 150.0m,
        RequestedTime = DateTime.UtcNow.AddDays(1)
    };

    private bool isBooking = false;
    private bool isResilientMode = true; // Default to resilient
    private string statusMessage = "";
    private bool isSuccess = false;
    private List<global::Appointment.Shared.Models.Appointment>? appointments;

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointments();
    }

    private async Task LoadAppointments()
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiClient");
            appointments = await client.GetFromJsonAsync<List<global::Appointment.Shared.Models.Appointment>>("/api/appointments");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading appointments: {ex.Message}");
        }
    }

    private async Task BookAppointment()
    {
        isBooking = true;
        statusMessage = isResilientMode ? "Booking with Polly Resilience... (Expect success!)" : "Booking in Naive mode... (Expect failures!)";
        isSuccess = false;
        StateHasChanged();

        try
        {
            var endpoint = isResilientMode ? "/api/appointments/book-resilient" : "/api/appointments/book-naive";
            
            var client = ClientFactory.CreateClient("ApiClient");
            var response = await client.PostAsJsonAsync(endpoint, bookingRequest);
            
            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
                statusMessage = $"Appointment booked successfully! (Mode: {(isResilientMode ? "Resilient" : "Naive")})";
                await LoadAppointments();
                
                // Reset form slightly
                bookingRequest.PatientId = "P-" + Guid.NewGuid().ToString().Substring(0, 5);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                isSuccess = false;
                statusMessage = $"Failed: {response.StatusCode}. {error}";
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            statusMessage = $"System Error: {ex.Message} (Simulated Chaos)";
        }
        finally
        {
            isBooking = false;
            StateHasChanged();
        }
    }

    private string GetDoctorName(string doctorId)
    {
        return doctorId switch
        {
            "DOC-101" => "Dr. Sarah Jenkins",
            "DOC-202" => "Dr. Michael Chen",
            "DOC-303" => "Dr. Emily Stone",
            "DOC-404" => "Dr. James Wilson",
            _ => "Unknown Specialist"
        };
    }
}
